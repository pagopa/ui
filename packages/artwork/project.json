{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pagopa-ui-artwork",
  "projectType": "library",
  "sourceRoot": "packages/artwork/src",
  "tags": ["type:data", "scope:design-system"],
  "targets": {
    "lint": {
      "configurations": {
        "ci": {
          "script": "lint:check"
        }
      }
    },
    "fmt": {
      "executor": "nx:run-script",
      "options": {
        "script": "format"
      },
      "cache": true,
      "configurations": {
        "ci": {
          "script": "format:check"
        }
      }
    },
    "test": {
      "dependsOn": ["check:artwork"]
    },
    "check:artwork": {
      "options": {
        "command": "node src/cli.ts check artwork",
        "cwd": "packages/ui-cli",
        "env": {
          "PAGOPA_UI_ROOT": "../pagopa-ui"
        }
      },
      "inputs": ["default", "tooling", "{workspaceRoot}/packages/pagopa-ui/src/catalog/figma/**"],
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": []
    }
  }
}
