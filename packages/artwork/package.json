{
  "name": "pagopa-ui-artwork",
  "private": true,
  "description": "The generated Figma artwork of the PagoPA design system",
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.ts"
    },
    "./pictograms/*": {
      "types": "./dist/types/components/icons/pictograms/*.d.ts",
      "import": "./src/components/icons/pictograms/*.ts"
    },
    "./pictogram-asset": {
      "types": "./dist/types/components/icons/pictogram-asset.d.ts",
      "import": "./src/components/icons/pictogram-asset.ts"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.0"
  }
}
