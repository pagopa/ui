{
  "name": "@pagopa/ui",
  "description": "PagoPA Web Design System",
  "license": "UNLICENSED",
  "version": "0.0.5",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pagopa/ui.git",
    "directory": "packages/pagopa-ui"
  },
  "exports": {
    ".": {
      "types": "./dist/types/pagopa-ui.d.ts",
      "import": "./dist/pagopa-ui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens": {
      "types": "./dist/types/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b && vite build && tsc -p tsconfig.lib.json && node ../ui-cli/src/cli.ts prepare-types && node ../ui-cli/src/cli.ts check css",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "typecheck": "tsc -b --force",
    "test": "vitest --run",
    "test:unit": "vitest --run --project unit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "react-day-picker": "^10.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "pagopa-ui-artwork": "workspace:*",
    "pagopa-ui-cli": "workspace:*",
    "pagopa-ui-tokens": "workspace:*",
    "playwright": "1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
