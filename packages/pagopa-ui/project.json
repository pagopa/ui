{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pagopa-ui",
  "projectType": "library",
  "sourceRoot": "packages/pagopa-ui/src",
  "tags": ["type:lib", "scope:design-system"],
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/figma-map.json"]
    },
    "typecheck": {
      "dependsOn": ["pagopa-ui-artwork:build", "pagopa-ui-tokens:build"]
    },
    "lint": {
      "configurations": {
        "ci": {
          "script": "lint:check"
        }
      }
    },
    "fmt": {
      "executor": "nx:run-script",
      "options": {
        "script": "format"
      },
      "cache": true,
      "configurations": {
        "ci": {
          "script": "format:check"
        }
      }
    },
    "test": {
      "dependsOn": [
        "api:check",
        "check:catalogue",
        "figma:map:check",
        "plugin:check",
        "pagopa-ui-artwork:test",
        "layers:check",
        "text-defaults:check",
        "foundation:check",
        "tokens:public:check",
        "client:check",
        "a11y:conformance:check",
        "pagopa-ui-cli:test",
        "pagopa-ui-cli:check:parity",
        "pagopa-ui-tokens:test"
      ],
      "configurations": {
        "ci": {
          "script": "test:unit"
        }
      }
    },
    "api:check": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "default",
        {
          "dependentTasksOutputFiles": "**/*.d.ts"
        }
      ],
      "outputs": ["{projectRoot}/dist/api"]
    },
    "api:update": {
      "dependsOn": ["build"],
      "cache": false
    },
    "docs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/cli.ts check docs",
        "cwd": "{workspaceRoot}/packages/ui-cli",
        "env": {
          "PAGOPA_UI_ROOT": "../pagopa-ui"
        }
      },
      "inputs": [
        "default",
        "tooling",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/packages/*/project.json",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/tools/*/project.json",
        "{workspaceRoot}/infra/**/project.json",
        "{workspaceRoot}/packages/tokens/src/**",
        "{workspaceRoot}/packages/artwork/src/**",
        "{workspaceRoot}/apps/storybook/src/**",
        "{workspaceRoot}/AGENTS.md",
        "{workspaceRoot}/CONTRIBUTING.md",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/docs/**",
        "{workspaceRoot}/.agents/**",
        "{workspaceRoot}/.github/workflows/**"
      ],
      "outputs": [],
      "cache": true
    },
    "check:catalogue": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/cli.ts check catalogue",
        "cwd": "{workspaceRoot}/packages/ui-cli",
        "env": {
          "PAGOPA_UI_ROOT": "../pagopa-ui"
        }
      },
      "inputs": [
        "default",
        "tooling",
        "{workspaceRoot}/packages/artwork/src/**",
        "{workspaceRoot}/apps/storybook/src/**/*",
        "{workspaceRoot}/docs/figma-parity/**",
        "{workspaceRoot}/pnpm-lock.yaml",
        { "runtime": "node --version" }
      ],
      "cache": true,
      "outputs": []
    },
    "update:stories": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/cli.ts update stories",
        "cwd": "{workspaceRoot}/packages/ui-cli",
        "env": {
          "PAGOPA_UI_ROOT": "../pagopa-ui"
        }
      },
      "outputs": [],
      "cache": false
    },
    "layers:check": {
      "options": {
        "command": "node src/cli.ts check layers"
      }
    },
    "figma:map": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node src/cli.ts figma map --write",
        "cwd": "{workspaceRoot}/packages/ui-cli",
        "env": { "PAGOPA_UI_ROOT": "../pagopa-ui" }
      },
      "outputs": ["{projectRoot}/figma-map.json"],
      "cache": false
    },
    "figma:map:check": {
      "options": { "command": "node src/cli.ts figma map" }
    },
    "plugin:check": {
      "options": { "command": "node src/cli.ts check plugin" }
    },
    "text-defaults:check": {
      "options": {
        "command": "node src/cli.ts check text-defaults --max 0"
      }
    },
    "foundation:check": {
      "options": {
        "command": "node src/cli.ts check foundation"
      },
      "inputs": [
        "default",
        "tooling",
        "{workspaceRoot}/packages/tokens/src/**",
        "{workspaceRoot}/apps/storybook/src/templates/**"
      ]
    },
    "tokens:public:check": {
      "options": {
        "command": "node src/cli.ts check public-tokens"
      },
      "inputs": ["default", "tooling", "{workspaceRoot}/packages/tokens/src/**"]
    },
    "client:check": {
      "options": {
        "command": "node src/cli.ts check client-directives"
      }
    },
    "a11y:conformance:check": {
      "options": {
        "command": "node src/cli.ts check a11y"
      },
      "inputs": [
        "default",
        "tooling",
        "{workspaceRoot}/apps/storybook/src/a11y/conformance.json",
        "{workspaceRoot}/apps/storybook/src/guides/accessibility.md"
      ]
    },
    "library:check": {
      "dependsOn": ["build"],
      "options": {
        "command": "node src/cli.ts check library"
      },
      "inputs": [
        "default",
        "tooling",
        "{workspaceRoot}/packages/artwork/src/**",
        "{workspaceRoot}/packages/tokens/src/**",
        {
          "dependentTasksOutputFiles": "**/*"
        },
        {
          "env": "LIBRARY_ENGINES"
        },
        {
          "runtime": "node --version"
        },
        {
          "runtime": "node -p \"process.platform + '-' + process.arch\""
        }
      ]
    },
    "nx-release-publish": {
      "options": {
        "registry": "https://npm.pkg.github.com"
      }
    }
  }
}
