{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pagopa-ui-cli",
  "projectType": "library",
  "sourceRoot": "packages/ui-cli",
  "tags": ["type:tooling", "scope:design-system"],
  "targets": {
    "lint": { "configurations": { "ci": { "script": "lint:check" } } },
    "fmt": {
      "executor": "nx:run-script",
      "options": { "script": "format" },
      "cache": true,
      "configurations": { "ci": { "script": "format:check" } }
    },
    "check:rules": {
      "cache": true,
      "inputs": [
        "figmaChecks",
        {
          "runtime": "node packages/ui-cli/src/adapters/rules-cache-input.ts"
        }
      ],
      "outputs": []
    },
    "check:context-budget": {
      "cache": true,
      "inputs": [
        "tooling",
        "{workspaceRoot}/.agents/skills/**",
        "{workspaceRoot}/.github/extensions/figma-align/**",
        "{workspaceRoot}/packages/pagopa-ui/src/catalog/figma/**",
        "{workspaceRoot}/docs/design-requests/**"
      ],
      "outputs": []
    },
    "check:devices": {
      "cache": true,
      "inputs": ["figmaChecks"],
      "outputs": []
    },
    "check:parity": {
      "cache": true,
      "inputs": ["figmaChecks"],
      "outputs": []
    },
    "check:evidence": {
      "cache": true,
      "inputs": ["figmaChecks"],
      "outputs": []
    },
    "test": {
      "inputs": [
        "default",
        "{workspaceRoot}/nx.json",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/packages/*/project.json",
        "{workspaceRoot}/packages/*/package.json",
        "{workspaceRoot}/apps/*/project.json",
        "{workspaceRoot}/apps/*/package.json",
        "{workspaceRoot}/tools/*/project.json",
        "{workspaceRoot}/infra/**/project.json",
        "{workspaceRoot}/packages/tokens/src/**",
        "{workspaceRoot}/packages/artwork/src/**",
        "{workspaceRoot}/.github/extensions/figma-align/**",
        "{workspaceRoot}/docs/figma-parity/**",
        "{workspaceRoot}/apps/storybook/src/**",
        "{workspaceRoot}/packages/pagopa-ui/src/**",
        "{workspaceRoot}/packages/pagopa-ui/figma-to-code.yaml"
      ]
    }
  }
}
