{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pagopa-ui-tokens",
  "projectType": "library",
  "sourceRoot": "packages/tokens/src",
  "tags": ["type:data", "scope:design-system"],
  "targets": {
    "lint": {
      "configurations": {
        "ci": {
          "script": "lint:check"
        }
      }
    },
    "fmt": {
      "executor": "nx:run-script",
      "options": {
        "script": "format"
      },
      "cache": true,
      "configurations": {
        "ci": {
          "script": "format:check"
        }
      }
    },
    "test": {
      "dependsOn": ["check:tokens"]
    },
    "check:tokens": {
      "options": {
        "command": "node src/cli.ts check tokens",
        "env": {
          "PAGOPA_UI_ROOT": "../pagopa-ui",
          "PAGOPA_UI_TOKENS_ROOT": "../tokens"
        },
        "cwd": "packages/ui-cli"
      },
      "inputs": [
        "default",
        "{workspaceRoot}/packages/ui-cli/**",
        "{workspaceRoot}/packages/pagopa-ui/src/index.css"
      ],
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": []
    }
  }
}
