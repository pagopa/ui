{
  "name": "pagopa-ui-storybook",
  "private": true,
  "description": "The deployable static Storybook of the design system",
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build -o dist",
    "test:stories": "vitest --run",
    "test:coverage": "vitest --run && vitest --run --coverage --mode coverage",
    "typecheck": "tsc -b --force",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@chromatic-com/storybook": "^5.5.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "lucide-react": "^1.52.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "pagopa-ui": "workspace:*",
    "pagopa-ui-artwork": "workspace:*",
    "pagopa-ui-tokens": "workspace:*",
    "playwright": "1.63.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
