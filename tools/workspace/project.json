{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "projectType": "application",
  "tags": ["type:tooling"],
  "targets": {
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": ["mise install --locked node pnpm", "pnpm nx run workspace:verify-full"]
      },
      "configurations": {
        "fast": {
          "commands": ["mise install --locked node pnpm", "pnpm nx run workspace:verify-fast"]
        }
      },
      "cache": false
    },
    "verify-full": {
      "dependsOn": [
        "verify-fast",
        "pagopa-ui-storybook:test:coverage",
        "pagopa-ui-storybook:test:stories",
        "pagopa-ui-storybook:build",
        "pagopa-ui:library:check"
      ]
    },
    "verify-fast": {
      "dependsOn": [
        "check:format",
        "pagopa-ui:typecheck",
        "pagopa-ui:format:check",
        "pagopa-ui:lint:check",
        "pagopa-ui:docs",
        "pagopa-ui:check:catalogue",
        "pagopa-ui:foundation:check",
        "pagopa-ui:layers:check",
        "pagopa-ui:utility-prefix:check",
        "pagopa-ui:consumer-dx:check",
        "pagopa-ui:build",
        "pagopa-ui:test",
        "pagopa-ui-artwork:typecheck",
        "pagopa-ui-artwork:format:check",
        "pagopa-ui-artwork:lint:check",
        "pagopa-ui-artwork:test",
        "pagopa-ui-tokens:typecheck",
        "pagopa-ui-tokens:format:check",
        "pagopa-ui-tokens:lint:check",
        "pagopa-ui-tokens:test",
        "pagopa-ui-cli:typecheck",
        "pagopa-ui-cli:format:check",
        "pagopa-ui-cli:lint:check",
        "pagopa-ui-cli:test"
      ]
    },
    "check:format": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "pnpm nx format:check"
      },
      "cache": false
    }
  }
}
