{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "workspace",
  "projectType": "application",
  "tags": ["type:tooling"],
  "targets": {
    "verify": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "parallel": false,
        "commands": [
          "pnpm nx run-many -p pagopa-ui -c=ci -t typecheck,fmt,lint,docs,figma:check,foundation:check,layers:check,build,test",
          "pnpm nx run-many -p pagopa-ui-artwork,pagopa-ui-tokens,pagopa-ui-cli -c=ci -t typecheck,fmt,lint",
          "pnpm nx run pagopa-ui-artwork:test",
          "pnpm nx run pagopa-ui-tokens:test",
          "pnpm nx run pagopa-ui-cli:test",
          "pnpm nx run pagopa-ui-cli:figma:rules:check",
          "pnpm nx run pagopa-ui-cli:figma:parity:verify",
          "pnpm nx run pagopa-ui-storybook:test:coverage",
          "pnpm nx run pagopa-ui-storybook:test:stories",
          "pnpm nx run pagopa-ui-storybook:build",
          "pnpm nx run pagopa-ui:library:check"
        ]
      },
      "configurations": {
        "fast": {
          "commands": [
            "pnpm nx run-many -p pagopa-ui -c=ci -t typecheck,fmt,lint,docs,figma:check,foundation:check,layers:check,build,test",
            "pnpm nx run-many -p pagopa-ui-artwork,pagopa-ui-tokens,pagopa-ui-cli -c=ci -t typecheck,fmt,lint",
            "pnpm nx run pagopa-ui-artwork:test",
            "pnpm nx run pagopa-ui-tokens:test",
            "pnpm nx run pagopa-ui-cli:test",
            "pnpm nx run pagopa-ui-cli:figma:rules:check",
            "pnpm nx run pagopa-ui-cli:figma:parity:verify"
          ]
        }
      },
      "cache": false
    }
  }
}
